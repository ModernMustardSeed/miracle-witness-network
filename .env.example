# The editor. Without it the keyword pass runs the paper on its own and every
# story is marked as placed by "rules" rather than "claude".
ANTHROPIC_API_KEY=

# The newsroom archive. Without both of these the site still publishes real
# stories, but it holds them in memory for fifteen minutes instead of keeping
# an archive, and the Send a Story form answers with the newsroom email.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron sends this as `Authorization: Bearer <value>` to /api/cron/scan.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
